---
// Documentation search. The index is built by Pagefind after `astro build`
// and queried in the browser; there is no backend. See src/scripts/ui.ts.
---

<dialog class="search" data-search aria-label="Search documentation">
  <div class="search__panel">
    <form class="search__form" role="search" data-search-form>
      <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="7" cy="7" r="4.75" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
      <label class="sr-only" for="search-input">Search documentation</label>
      <input
        id="search-input"
        class="search__input"
        type="search"
        placeholder="Search documentation"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        data-search-input
      />
      <button class="search__close" type="button" data-search-close aria-label="Close search">Esc</button>
    </form>

    <div class="search__body">
      <p class="search__status" data-search-status role="status" aria-live="polite">
        Type to search the documentation.
      </p>
      <ul class="search__results" id="search-results" role="listbox" aria-label="Search results" data-search-results>
      </ul>
    </div>

    <div class="search__foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style is:global>
  .search {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 4rem));
    margin: clamp(1rem, 10vh, 6rem) auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--deep-navy);
    color: var(--text-2);
    overflow: hidden;
  }
  .search::backdrop {
    background: var(--backdrop);
  }
  .search[open] {
    display: flex;
  }
  .search__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }
  .search__form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 0.75rem 0 1.1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-3);
  }
  .search__input {
    flex: 1;
    min-width: 0;
    height: 56px;
    border: 0;
    background: transparent;
    color: var(--ivory);
    font: inherit;
    font-size: 1.0625rem;
  }
  .search__input::placeholder {
    color: var(--text-3);
  }
  .search__input:focus-visible {
    outline: none;
  }
  .search__input::-webkit-search-cancel-button {
    display: none;
  }
  .search__close {
    flex: none;
    min-width: 44px;
    min-height: 32px;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-3);
  }
  .search__close:hover {
    color: var(--ivory);
  }
  .search__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .search__status {
    padding: 1.1rem 1.1rem 0.5rem;
    font-size: var(--text-small);
    color: var(--text-3);
  }
  .search__status:empty {
    display: none;
  }
  .search__results {
    margin: 0;
    padding: 0.35rem;
    list-style: none;
  }
  .search__results:empty {
    display: none;
  }
  .search-result {
    display: block;
    padding: 0.7rem 0.75rem;
    border-radius: var(--radius-m);
    border: 1px solid transparent;
  }
  .search-result[aria-selected='true'] {
    background: var(--surface);
    border-color: var(--border);
  }
  .search-result__crumb {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--text-3);
  }
  .search-result__title {
    display: block;
    margin-top: 0.15rem;
    color: var(--ivory);
    font-weight: 500;
  }
  .search-result__excerpt {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--text-2);
  }
  .search-result__excerpt mark {
    background: transparent;
    color: var(--amber-ink);
    font-weight: 500;
  }
  .search__foot {
    display: flex;
    gap: 1.25rem;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-3);
    background: var(--midnight);
  }
  .search__foot kbd {
    display: inline-block;
    min-width: 1.3rem;
    margin-right: 0.3rem;
    padding: 0.05rem 0.3rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    text-align: center;
    font-size: inherit;
  }
  @media (max-width: 560px) {
    .search {
      margin-top: 0.75rem;
      max-height: calc(100dvh - 1.5rem);
    }
    .search__foot {
      display: none;
    }
  }
</style>
