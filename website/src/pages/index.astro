  .txn li {
    position: relative;
    padding: 1.4rem 1.25rem 0.25rem 0;
  }
  .txn li::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--ivory);
    transform: rotate(45deg);
  }
  .txn__step {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ivory);
  }
  .txn code {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.6875rem;
    color: var(--blue-ink);
    overflow-wrap: anywhere;
  }
  .txn p {
    margin-top: 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .txn__fail .txn__step {
    color: var(--amber-ink);
  }
  .txn__fail::before {
    background: var(--amber) !important;
  }

  /* ----------------------------------------------------------------- steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .steps li {
    position: relative;
    padding: 1.75rem 1.75rem 0.25rem 0;
  }
  .steps li:last-child {
    padding-right: 0;
  }
  .steps__node {
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--amber);
    transform: rotate(45deg);
  }
  .steps h3 {
    margin-top: 0.85rem;
    font-size: 1.375rem;
  }
  .steps__cmd {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--blue-ink);
  }
  .steps p {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .steps__docs {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.9rem;
    min-height: 32px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
  }
  .steps__docs:hover {
    color: var(--ivory);
  }

  /* -------------------------------------------------------------- security */
  .sec-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem var(--gutter);
    align-items: start;
  }
  .layers h3,
  .checks h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .layers dl {
    margin: 1.1rem 0 0;
    border-top: 1px solid var(--border);
  }
  .layers dl div {
    padding: 1rem 0 1.1rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .layers dt {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    color: var(--ivory);
    font-weight: 500;
  }
  .layers dt span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--blue-ink);
  }
  .layers dd {
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .layers .is-open dt span {
    color: var(--amber-ink);
  }
  .sec-lower {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem var(--gutter);
    align-items: start;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .checks ul {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .checks li {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.1rem 1.5rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border-soft);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .checks b {
    font-weight: 500;
    color: var(--ivory);
  }
  .limits {
    padding: 1.6rem 1.6rem 1.75rem;
    background: var(--card);
    border: 1px solid var(--amber);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
  }
  .limits h3 {
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .limits ul {
    margin: 1.1rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .limits li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* ------------------------------------------------------- reproducibility */
  .repro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem var(--gutter);
    align-items: start;
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    border-top: 1px solid var(--border);
  }
  .fields {
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .fields div {
    padding: 0.8rem 0 0.9rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .fields dt code {
    font-size: 0.8125rem;
    color: var(--blue-ink);
  }
  .fields dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .repro__limits {
    margin-top: 2.25rem;
  }
  .repro__limits h3 {
    font-size: 1.125rem;
  }
  .repro__limits ul {
    margin: 0.9rem 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .repro__limits li {
    position: relative;
    padding: 0.4rem 0 0.4rem 1.4rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .repro__limits li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.95rem;
    width: 6px;
    height: 6px;
    border: 1px solid var(--amber);
    transform: rotate(45deg);
  }

  /* ------------------------------------------------------------- comparison */
  .compare {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--card);
    box-shadow: var(--shadow-card-sm);
  }
  .compare__table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .compare__table th,
  .compare__table td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .compare__table thead th {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-2);
    background: var(--card-subtle);
  }
  .compare__table tbody th {
    font-weight: 500;
    color: var(--ivory);
    min-width: 12rem;
  }
  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td {
    border-bottom: 0;
  }
  .compare__col-sp,
  .compare__cell-sp {
    background: color-mix(in srgb, var(--electric) 5%, transparent);
  }
  .compare__col-sp {
    background: color-mix(in srgb, var(--electric) 8%, var(--card-subtle)) !important;
  }
  .compare__sp {
    color: var(--blue-ink);
  }
  .compare__note {
    max-width: 46rem;
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--text-3);
  }

  /* -------------------------------------------------------------- commands */
  .cmds {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .cmds li {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr) auto;
    gap: 0.5rem 2rem;
    align-items: center;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .cmds__cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.35rem 0.4rem 0.35rem 0.85rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card-sm);
    transition: border-color var(--dur) var(--ease);
  }
  .cmds li:hover .cmds__cmd {
    border-color: var(--text-3);
  }
  .cmds__cmd code {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--ivory);
    scrollbar-width: none;
  }
  .cmds__cmd code::-webkit-scrollbar {
    display: none;
  }
  .cmds .t-prompt {
    color: var(--amber-ink);
    user-select: none;
  }
  .cmds p {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .cmds li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
    white-space: nowrap;
  }
  .cmds li > a:hover {
    color: var(--ivory);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .more__cell {
    padding: 1.5rem 1.6rem 1.6rem;
    background: var(--card);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-card-sm);
  }
  .more__cell h3 {
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .more__cell p {
    margin-top: 0.65rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-2);
  }
  .more__cell .arrow-link {
    display: inline-flex;
    margin-top: 0.9rem;
  }

  /* -------------------------------------------------------------- onboarding */
  .onboard {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: 2.5rem var(--gutter);
    align-items: start;
  }
  .onboard__panel {
    min-width: 0;
  }
  .onboard__panel > .overline {
    margin-bottom: 0.9rem;
  }
  .onboard__first {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .onboard__first li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.1rem 0.75rem;
    padding: 1.15rem 0 1.3rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .onboard__first .index {
    padding-top: 0.5rem;
  }
  .onboard__cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.35rem 0.4rem 0.35rem 0.85rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
  }
  .onboard__cmd code {
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--ivory);
    scrollbar-width: none;
  }
  .onboard__cmd code::-webkit-scrollbar {
    display: none;
  }
  .onboard__cmd .t-prompt {
    color: var(--amber-ink);
    user-select: none;
  }
  .onboard__first li p {
    grid-column: 2;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* ----------------------------------------------------------- open source */
  .links {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
  }
  .links li {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .links a {
    position: relative;
    display: block;
    padding: 1.1rem 2.25rem 1.2rem 1.15rem;
    background: var(--card-subtle);
    transition: background-color var(--dur) var(--ease);
  }
  .links a:hover {
    background: var(--card);
  }
  .links__label {
    display: block;
    color: var(--ivory);
    font-weight: 500;
  }
  .links__detail {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }
  .links__arrow {
    position: absolute;
    top: 1.05rem;
    right: 1rem;
    font-family: var(--font-mono);
    color: var(--text-3);
    transition:
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease-out);
  }
  .links a:hover .links__arrow {
    color: var(--amber-ink);
    transform: translate(2px, -2px);
  }
  .closing {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) auto;
    gap: 1.5rem var(--gutter);
    align-items: center;
    margin-top: clamp(3.5rem, 2rem + 5vw, 6rem);
  }
  .closing h2 {
    font-size: var(--text-h2);
    line-height: 1.05;
    letter-spacing: -0.028em;
  }
  .closing p {
    margin-top: 0.75rem;
  }
  .closing__cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card-sm);
  }
  .closing__cmd code {
    font-size: 0.9375rem;
    color: var(--ivory);
    white-space: nowrap;
  }
  .closing__cmd .t-prompt {
    color: var(--amber-ink);
  }
  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ------------------------------------------------------- motion & flow */
  /* Pointer-tracked elevation glow on the interactive cards. */
  .ba-card,
  .more__cell,
  .limits {
    position: relative;
    isolation: isolate;
  }
  .ba-card::before,
  .more__cell::before,
  .limits::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      18rem circle at var(--card-x, 50%) var(--card-y, 0%),
      rgb(21 91 232 / 0.09),
      transparent 68%
    );
    opacity: 0;
    transition: opacity 320ms var(--ease);
    pointer-events: none;
  }
  .ba-card:hover::before,
  .more__cell:hover::before,
  .limits:hover::before {
    opacity: 1;
  }
  .ba-card,
  .more__cell {
    transition:
      border-color var(--dur-med) var(--ease),
      box-shadow var(--dur-med) var(--ease),
      transform var(--dur-med) var(--ease-out);
  }
  .ba-card:hover,
  .more__cell:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .ba-card--after:hover {
    border-color: color-mix(in srgb, var(--electric) 70%, var(--border));
  }

  /* A packet sweeps along the install-transaction rail, lighting each node in
     turn. The failure branch is the last stop and stays amber. */
  .txn {
    position: relative;
  }
  .txn::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 22%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--amber), transparent);
    animation: txn-flow 5.2s var(--ease) infinite;
    pointer-events: none;
  }
  @keyframes txn-flow {
    0% {
      transform: translateX(-110%);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    86% {
      opacity: 1;
    }
    100% {
      transform: translateX(460%);
      opacity: 0;
    }
  }
  .txn li::before {
    animation: txn-node 5.2s var(--ease) infinite;
  }
  .txn li:nth-child(2)::before {
    animation-delay: 0.5s;
  }
  .txn li:nth-child(3)::before {
    animation-delay: 1s;
  }
  .txn li:nth-child(4)::before {
    animation-delay: 1.5s;
  }
  .txn li:nth-child(5)::before {
    animation-delay: 2.1s;
  }
  @keyframes txn-node {
    0%,
    28%,
    100% {
      background: var(--ivory);
      box-shadow: 0 0 0 0 rgb(241 138 80 / 0);
    }
    10% {
      background: var(--amber);
      box-shadow: 0 0 0 4px rgb(241 138 80 / 0.16);
    }
  }
  .txn__fail::before {
    animation-name: txn-node-fail;
  }
  @keyframes txn-node-fail {
    0%,
    34%,
    100% {
      background: var(--amber);
      box-shadow: 0 0 0 0 rgb(241 138 80 / 0);
    }
    14% {
      background: var(--amber);
      box-shadow: 0 0 0 5px rgb(241 138 80 / 0.22);
    }
  }

  /* The 3-step workflow rail draws itself in once, then keeps a slow travelling
     highlight so the sequence reads as one pipeline rather than three columns. */
  .steps {
    position: relative;
  }
  .steps::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--electric), var(--amber));
    transform: scaleX(1);
    transform-origin: left center;
  }
  .steps[data-reveal='pending']::after {
    transform: scaleX(0);
  }
  .steps[data-reveal='in']::after {
    animation: steps-draw 900ms var(--ease-out) 120ms both;
  }
  @keyframes steps-draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .steps__node {
    animation: steps-node 3.6s var(--ease) infinite;
  }
  .steps li:nth-child(2) .steps__node {
    animation-delay: 0.45s;
  }
  .steps li:nth-child(3) .steps__node {
    animation-delay: 0.9s;
  }
  @keyframes steps-node {
    0%,
    26%,
    100% {
      box-shadow: 0 0 0 0 rgb(241 138 80 / 0);
    }
    9% {
      box-shadow: 0 0 0 5px rgb(241 138 80 / 0.2);
    }
  }
  .steps__cmd {
    position: relative;
  }
  .steps__docs .arrow-link,
  .arrow-link {
    transition:
      color var(--dur) var(--ease),
      gap var(--dur) var(--ease-out);
  }

  /* Before/after: the drift rows in the 'before' card flicker faintly so the
     mismatch reads as instability, while the 'after' rows settle. */
  .ba-card--before .ba-card__list li:nth-child(1) span {
    animation: ba-jitter 6s var(--ease) infinite;
  }
  .ba-card--before .ba-card__list li:nth-child(2) span {
    animation: ba-jitter 6s var(--ease) 1.4s infinite;
  }
  .ba-card--before .ba-card__list li:nth-child(3) span {
    animation: ba-jitter 6s var(--ease) 2.8s infinite;
  }
  @keyframes ba-jitter {
    0%,
    88%,
    100% {
      opacity: 1;
    }
    92% {
      opacity: 0.45;
    }
    96% {
      opacity: 0.85;
    }
  }

  /* ------------------------------------------------------------ responsive */
  @media (max-width: 1100px) {
    .txn::after {
      display: none;
    }
    .txn {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 1.5rem;
      border-top: 0;
    }
    .txn li {
      border-top: 1px solid var(--amber);
    }
    .closing {
      grid-template-columns: 1fr 1fr;
    }
    .closing > div:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 980px) {
    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero__lead {
      max-width: 40rem;
    }
    .sec-grid,
    .sec-lower,
    .repro,
    .feature,
    .answer__head,
    .onboard,
    .before-after {
      grid-template-columns: 1fr;
    }
    .feature--flip .feature__text {
      order: 0;
    }
    .steps::after {
      display: none;
    }
    .steps {
      grid-template-columns: 1fr;
      row-gap: 2.25rem;
      border-top: 0;
    }
    .steps li {
      border-top: 1px solid var(--border);
      padding-right: 0;
    }
    .more {
      grid-template-columns: 1fr;
    }
    .links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cmds li {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .cmds__cmd {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .problems li {
      grid-template-columns: 2rem minmax(0, 1fr);
      padding: 1.25rem 0 1.4rem;
    }
    .problems p {
      grid-column: 2;
    }
    .txn {
      grid-template-columns: 1fr;
      row-gap: 0;
      border-left: 1px solid var(--amber);
    }
    .txn li {
      padding: 0 0 1.5rem 1.25rem;
      border-top: 0;
    }
    .txn li::before {
      top: 0.3rem;
      left: -4px;
    }
    .checks li {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
    .hero__facts {
      flex-direction: column;
      gap: 0.35rem;
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .links {
      grid-template-columns: 1fr;
    }
    .closing {
      grid-template-columns: 1fr;
