---
import CodeFrame from '../components/CodeFrame.astro';
import CopyButton from '../components/CopyButton.astro';
import FanOut from '../components/FanOut.astro';
import HarnessMatrix from '../components/HarnessMatrix.astro';
import HeroArchitecture from '../components/HeroArchitecture.astro';
import InstallPanel from '../components/InstallPanel.astro';
import SectionHead from '../components/SectionHead.astro';
import TerminalDemo from '../components/TerminalDemo.astro';
import Transcript from '../components/Transcript.astro';
import lock from '../data/recordings/skillporter.lock.json';
import { cliData, harnessData, LINKS, release, SITE } from '../data/site';
import Base from '../layouts/Base.astro';

const { counts } = harnessData;

/* ---- Lockfile example: the real recorded lockfile, with long lists cut. */
const locked = lock.skills.pdf;
const fileHashNames = Object.keys(locked.file_hashes) as (keyof typeof locked.file_hashes)[];
const shownHashes = fileHashNames.slice(0, 3);
const lockExample = JSON.stringify(
  {
    ...lock,
    skills: {
      pdf: {
        ...locked,
        file_hashes: Object.fromEntries(shownHashes.map((name) => [name, locked.file_hashes[name]])),
        installed_targets: locked.installed_targets.slice(0, 3),
      },
    },
  },
  null,
  2,
);
const lockNote = `Written by skillporter ${release.version}. Shortened for display: ${shownHashes.length} of ${fileHashNames.length} file hashes and 3 of ${locked.installed_targets.length} targets shown.`;

/* ---- Workflow commands. Each is checked against the real argument parser
        at build time, so a renamed command or flag fails the build. */
interface WorkflowCommand {
  command: string;
  does: string;
  docs: string;
}
const workflow: WorkflowCommand[] = [
  {
    command: 'skillporter demo',
    does: 'Builds a broken workspace in a temporary directory, repairs it and removes it. Writes nothing to your project.',
    docs: '/docs/getting-started',
  },
  {
    command: 'skillporter add anthropics/skills --skill pdf --harness all',
    does: 'Resolves the source, validates and assesses the skill, then installs it for every harness.',
    docs: '/docs/skill-management',
  },
  {
    command: 'skillporter status',
    does: 'Shows manifest, lockfile, active profile, managed vs. unmanaged skills and drift in one view.',
    docs: '/docs/cli#skillporter-status-path',
  },
  {
    command: 'skillporter export team.skillpack',
    does: 'Packages skills, provenance, lockfile hashes and profiles into a SHA-256 verified offline archive.',
    docs: '/docs/portability',
  },
  {
    command: 'skillporter import team.skillpack --dry-run',
    does: 'Verifies archive hashes, scans bundled skills and previews destination and harness compatibility.',
    docs: '/docs/portability#importing-and-restoring-an-environment',
  },
  {
    command: 'skillporter diff team.skillpack',
    does: 'Compares your current setup against a .skillpack archive, another project or a named profile.',
    docs: '/docs/portability#comparing-environments',
  },
  {
    command: 'skillporter scan .',
    does: 'Runs the static security assessment on every skill in the workspace.',
    docs: '/docs/security-scanning',
  },
  {
    command: 'skillporter sync',
    does: 'Reconciles the workspace with the manifest and writes skillporter.lock.',
    docs: '/docs/synchronization',
  },
  {
    command: 'skillporter lock --check',
    does: 'Exits 1 when the lockfile is stale or files on disk no longer match it.',
    docs: '/docs/lockfiles',
  },
  {
    command: 'skillporter self-skill install --harness detected',
    does: 'Installs the official Skillporter skill into your detected AI coding agents.',
    docs: '/docs/mcp',
  },
  {
    command: 'skillporter rollback pdf',
    does: 'Restores a skill from its most recent snapshot in .skillporter/backups/.',
    docs: '/docs/skill-management#updating-and-rolling-back',
  },
];

interface CliSpec {
  flags: string[];
  subcommands?: Record<string, CliSpec>;
}
const commands = cliData.commands as Record<string, CliSpec>;
for (const { command } of workflow) {
  const [, name, ...rest] = command.split(' ');
  let spec = name ? commands[name] : undefined;
  if (!spec) throw new Error(`Home page shows an unknown command: ${command}`);
  const subName = rest[0];
  const flagTokens = subName && spec.subcommands?.[subName] ? ((spec = spec.subcommands[subName]), rest.slice(1)) : rest;
  for (const flag of flagTokens.filter((part) => part.startsWith('--'))) {
    if (!spec.flags.includes(flag)) throw new Error(`Home page shows an unknown flag: ${command}`);
  }
}

const addExamples = `# A skill from a GitHub repository, for every compatible harness except Windsurf
skillporter add anthropics/skills --skill pdf --harness compatible --exclude-harness windsurf

# A subdirectory pinned to a tag, skipping any pre-existing unmanaged destination
skillporter add owner/repo/skills/pdf@v1.2.0 --harness claude-code --harness codex --on-conflict skip

# A local directory, installed into Cursor's dedicated folder without sharing .agents/skills
skillporter install ./skills/release-notes --harness cursor --isolated --dry-run`;

const policyExample = `# skillporter.policy.yaml, committed with the repository
block_severity: HIGH
max_risk_score: 30
banned_capabilities:
  - network
approved_sources:
  - Shanmukh-l33t/*

# Read what changes before accepting an update
skillporter update --check`;

const problems = [
  {
    title: 'Every harness reads a different directory',
    body: 'Claude Code reads .claude/skills. Codex and Zed read .agents/skills. GitHub Copilot reads .github/skills. A skill placed in one is invisible to the others.',
  },
  {
    title: 'Manual installs repeat',
    body: 'One skill for five tools is five copies, made again for every update and every teammate.',
  },
  {
    title: 'Copies drift',
    body: 'Edit one copy and the rest keep the old instructions. Two agents in the same repository now follow different versions.',
  },
  {
    title: 'Shared directories have several owners',
    body: `${counts.shared_primary} harnesses use .agents/skills as their primary path. Deleting a skill for one of them deletes it for all of them.`,
  },
  {
    title: 'Upstream moves',
    body: 'A skill installed from a branch today is not guaranteed to be the same skill tomorrow.',
  },
  {
    title: 'A skill is an untrusted dependency',
    body: 'It is instructions and scripts that an agent loads and may execute. It deserves the scrutiny you give any other dependency.',
  },
];

/* Three-step product workflow shown in How it works. */
const steps = [
  {
    index: '01',
    title: 'Manage',
    command: 'skillporter add <source>',
    body: 'Bring skills into one workflow from a GitHub repository, a Git URL, an archive or a local directory. Skillporter resolves, validates and assesses before anything is written.',
    docs: '/docs/skill-management',
  },
  {
    index: '02',
    title: 'Synchronize',
    command: 'skillporter sync',
    body: 'Distribute the skill to every supported agent directory, keep one record of what was installed and from which commit, and detect drift when a copy changes on disk.',
    docs: '/docs/synchronization',
  },
  {
    index: '03',
    title: 'Protect',
    command: 'skillporter scan .',
    body: 'Statically validate skill contents, assess risk and pin file hashes in the lockfile, so a later install reproduces the same bytes or tells you exactly what differs.',
    docs: '/docs/security-scanning',
  },
];

const transaction = [
  { step: 'Stage', path: '.skillporter/tmp/txn-<id>/', body: 'New content is copied to a staging directory inside the workspace.' },
  { step: 'Journal', path: 'journal.json', body: 'Every path that will be created or replaced is written down before anything moves.' },
  { step: 'Swap', path: '.claude/skills/pdf  .agents/skills/pdf', body: 'Directories move into place. Replaced content is kept until every destination succeeds.' },
  { step: 'Commit', path: '.skillporter/state.json', body: 'State and the audit log are written atomically. The journal is cleared.' },
];

const securityLayers = [
  {
    name: 'Static analysis',
    by: 'skillporter scan',
    tells: 'Whether known dangerous patterns were found in the files.',
    covered: true,
  },
  {
    name: 'Structural validation',
    by: 'validate, archive and path checks',
    tells: 'That the package is well formed and cannot write outside its destination.',
    covered: true,
  },
  {
    name: 'Content integrity',
    by: 'skillporter.lock',
    tells: 'That the bytes on disk are the bytes that were pinned.',
    covered: true,
  },
  {
    name: 'Runtime behavior',
    by: 'Not covered',
    tells: 'What a skill does once an agent runs it is decided by the model, the harness and the host.',
    covered: false,
  },
];

const securityChecks = [
  ['Python AST inspection', 'shell=True, eval and exec, pickle loading, dynamic imports, credential file reads'],
  ['JavaScript and TypeScript checks', 'new Function, vm, child_process, remote import()'],
  ['Instruction analysis', 'override phrasing, hidden HTML comments, hidden Unicode, exfiltration directives'],
  ['Secret detection', 'private keys, cloud access keys, tokens'],
  ['Encoded payload checks', 'bounded Base64, hex and PowerShell -EncodedCommand decoding'],
  ['Cross-file pattern analysis', 'a payload stored in one file, decoded in another, executed from a third'],
  ['Unsafe archive detection', 'path traversal, reserved names, decompression limits'],
  ['Symlink and filesystem protection', 'links that leave the skill root, escaping parent directories'],
  ['Installer integrity verification', 'immutable tags, SHA-256, attestation or a pinned digest'],
  ['Audit logging', 'accepted risks recorded in .skillporter/audit.jsonl, credentials scrubbed'],
];

const limitations = [
  'A prompt injection written in ordinary prose, without known override phrasing, can pass.',
  'A URL can serve harmless content at scan time and something else when the agent fetches it.',
  'Encoded-payload inspection is bounded. Layered encoding or encryption can evade it.',
  'Which tools an agent may call is enforced by the harness and the host, not by Skillporter.',
];

const lockFields = [
  ['resolved_commit', 'The full Git commit the source resolved to. Sync installs this commit even after the branch moves.'],
  ['tree_hash', 'One SHA-256 over the whole skill directory.'],
  ['file_hashes', 'A SHA-256 per file, so a mismatch points at the file that changed.'],
  ['pin_state', 'PINNED_COMMIT, PINNED_CONTENT or UNPINNED_MUTABLE.'],
  ['dependencies', 'Other skills this one requires, with resolved versions.'],
  ['adapter_version', 'The Skillporter version whose adapters wrote the install.'],
  ['reproducible', 'True only when no entry is UNPINNED_MUTABLE.'],
];

/* Differentiation: what manual management and copy scripts can and cannot do. */
const comparison = [
  {
    dim: 'Cross-agent install',
    manual: 'Copy the folder into each agent directory by hand',
    scripts: 'Possible with a script you write and maintain',
    sp: 'One command plans every destination per adapter',
  },
  {
    dim: 'Shared .agents/skills ownership',
    manual: 'Unseen: seven agents read the same copy',
    scripts: 'Rarely handled; deletes are unsafe',
    sp: 'Written once, removed only when no reader needs it',
  },
  {
    dim: 'Synchronization and drift',
    manual: 'Not tracked',
    scripts: 'Requires separate tooling',
    sp: 'Built in: sync reconciles, diagnose names the drifted hash',
  },
  {
    dim: 'Lockfiles and reproducibility',
    manual: 'Requires manual setup',
    scripts: 'Requires manual setup',
    sp: 'Built in: skillporter.lock pins commit and per-file hashes',
  },
  {
    dim: 'Integrity and risk verification',
    manual: 'Separate tooling, if any',
    scripts: 'Separate tooling, if any',
    sp: 'Built in: static scan, structural checks, exit codes for CI',
  },
  {
    dim: 'Transactional install and rollback',
    manual: 'Not inherent',
    scripts: 'Not inherent',
    sp: 'Journal-based; a killed install is rolled back on the next run',
  },
  {
    dim: 'Portable environments for teammates',
    manual: 'Re-install everything by hand',
    scripts: 'Possible, but ad hoc',
    sp: 'One .skillpack archive, verified on import',
  },
];

const projectLinks = [
  { label: 'Repository', detail: 'Shanmukh-l33t/skillporter', href: LINKS.repo },
  { label: 'Latest release', detail: release.tag, href: LINKS.release },
  { label: 'Changelog', detail: 'CHANGELOG.md', href: LINKS.changelog },
  { label: 'Security policy', detail: 'SECURITY.md', href: LINKS.security },
  { label: 'Contributing guide', detail: 'CONTRIBUTING.md', href: LINKS.contributing },
  { label: 'License', detail: release.license, href: LINKS.license },
  { label: 'PyPI', detail: release.pypi_package, href: LINKS.pypi },
  { label: 'npm', detail: release.npm_package, href: LINKS.npm },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    alternateName: SITE.alternateName,
    url: SITE.url,
    logo: `${SITE.url}/brand/skillporter-logo.png`,
    sameAs: [release.repository, LINKS.pypi, LINKS.npm],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.alternateName,
    url: SITE.url,
    description: SITE.description,
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: SITE.name,
    alternateName: SITE.alternateName,
    description: SITE.description,
    url: SITE.url,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS, Windows',
    softwareVersion: release.version,
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: release.repository,
    downloadUrl: LINKS.release,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: `${SITE.name} source`,
    description: SITE.description,
    url: release.repository,
    codeRepository: release.repository,
    programmingLanguage: 'Python',
    license: 'https://opensource.org/licenses/MIT',
    runtimePlatform: 'Linux, macOS, Windows',
    isPartOf: { '@type': 'SoftwareApplication', name: SITE.name, softwareVersion: release.version },
  },
];
---

<Base
  title="Skillporter: the package manager for AI agent skills"
  description={SITE.description}
  path="/"
  structuredData={structuredData}
>
  <main id="main">
    <!-- ============================== HERO ============================== -->
    <section class="hero">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="overline">AI AGENT SKILL MANAGEMENT</p>
          <h1 class="hero-title">
            <span class="hero-title__mask">
              <span class="hero-title__line hero-title__line--1"
                >Manage AI agent skills across every coding assistant.</span
              >
            </span>
            <span class="hero-title__mask">
              <span class="hero-title__line hero-title__line--2"
                ><span class="hero-title__sheen">From one place.</span
                ><span class="hero-title__span" aria-hidden="true"><b><i></i></b></span
              ></span>
            </span>
          </h1>
          <p class="hero__lead">
            Skillporter is the package manager for AI agent skills. Install, synchronize, secure, and reproduce skills
            across your development environments. Manage your skills once and keep every supported agent in sync.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/docs/getting-started">Get Started</a>
            <a class="btn btn--secondary" href={LINKS.repo} rel="noopener">Explore GitHub</a>
          </div>
          <p class="hero__hint">
            <code>uvx skillporter demo</code> runs the whole workflow in a temporary directory. Nothing is installed,
            nothing is sent anywhere.
          </p>
        </div>

        <div class="hero__visual">
          <HeroArchitecture />
        </div>
      </div>

      <div class="wrap">
        <ul class="hero__facts" aria-label="Project facts">
          <li><b>{counts.total}</b> harness adapters</li>
          <li>Runs locally, no account</li>
          <li>Python 3.9+, no runtime dependencies</li>
          <li>{release.license} licensed</li>
        </ul>
      </div>
    </section>

    <!-- ============================ PROBLEM ============================= -->
    <section class="section" id="problem" aria-labelledby="problem-title">
      <div class="wrap">
        <SectionHead index="01" label="The problem" id="problem-title" title="Your AI workflows are spreading across agents. Your skills shouldn't become fragmented.">
          Every harness looks for skills in its own directory. Keeping one skill available to several of them means
          copying it by hand, and hand-made copies do not stay equal.
        </SectionHead>

        <ol class="problems">
          {
            problems.map((problem, i) => (
              <li>
                <span class="index">{String(i + 1).padStart(2, '0')}</span>
                <h3>{problem.title}</h3>
                <p>{problem.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="before-after" aria-label="Before and after centralized skill management">
          <div class="ba-card ba-card--before">
            <div class="ba-card__head">
              <span class="overline">Before · Manual folders</span>
              <span class="ba-card__tag ba-card__tag--warn">Fragmented &amp; drifting</span>
            </div>
            <ul class="ba-card__list">
              <li>
                <code>.claude/skills/pdf/SKILL.md</code>
                <span>edited locally · out of sync</span>
              </li>
              <li>
                <code>.windsurf/skills/pdf/SKILL.md</code>
                <span>stale copy from two weeks ago</span>
              </li>
              <li>
                <code>.github/skills/pdf/</code>
                <span>missing in GitHub Copilot</span>
              </li>
              <li>
                <code>.agents/skills/pdf/</code>
                <span>shared by {counts.shared_primary} agents · unsafe to delete manually</span>
              </li>
            </ul>
          </div>

          <div class="ba-card ba-card--after">
            <div class="ba-card__head">
              <span class="overline">After · Managed with Skillporter</span>
              <span class="ba-card__tag ba-card__tag--ok">Pinned &amp; synchronized</span>
            </div>
            <ul class="ba-card__list">
              <li>
                <code>skillporter.yaml + skillporter.lock</code>
                <span>commit &amp; per-file SHA-256 recorded</span>
              </li>
              <li>
                <code>.claude/skills/pdf · .windsurf/skills/pdf</code>
                <span>verified identical bytes</span>
              </li>
              <li>
                <code>.agents/skills/pdf</code>
                <span>written once · shared safely across {counts.shared_primary} harnesses</span>
              </li>
              <li>
                <code>skillporter lock --check</code>
                <span>flags drift immediately locally or in CI</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="answer">
          <div class="answer__head">
            <h3>One install reaches every directory cleanly.</h3>
            <p>
              <code class="ic">skillporter add</code> plans a destination per adapter and writes each directory once.
              Harnesses that share a directory share the copy.
            </p>
          </div>
          <FanOut />
          <p class="answer__caveat">
            Harnesses still differ, and Skillporter does not hide it. Claude Code reads only its own directory, Cline
            limits the size of a skill body, and core Aider needs a conventions file. Those differences are recorded per
            adapter. <a class="text-link" href="/docs/harnesses#harness-differences-that-matter">See the differences</a>
          </p>
        </div>
      </div>
    </section>

    <!-- =========================== HOW IT WORKS ========================= -->
    <section class="section section--alt" id="how-it-works" aria-labelledby="how-title">
      <div class="wrap">
        <SectionHead index="02" label="How it works" id="how-title" title="Three moves, all on your machine.">
          Skillporter is a command-line tool. It runs where you run it: a laptop, a container, a CI runner. This website
          installs nothing and executes nothing.
        </SectionHead>

        <ol class="steps">
          {
            steps.map((step) => (
              <li>
                <span class="steps__node" aria-hidden="true" />
                <span class="index">{step.index}</span>
                <h3>{step.title}</h3>
                <code class="steps__cmd">{step.command}</code>
                <p>{step.body}</p>
                <a class="steps__docs" href={step.docs}>
                  Docs <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ====================== CAPABILITIES: PILLARS ===================== -->
    <section class="section" id="capabilities" aria-labelledby="capabilities-title">
      <div class="wrap">
        <SectionHead index="03" label="Core capabilities" id="capabilities-title" title="A package manager's job, done for skills.">
          Installing is the entry point. What stays behind matters more: a record of what was installed, where, from
          which commit, and whether it has changed since.
        </SectionHead>

        <article class="feature">
          <div class="feature__text">
            <span class="index">Pillar A</span>
            <h3>Skill management</h3>
            <p class="feature__kicker">One workflow to manage skills across your AI coding environments.</p>
            <p>
              Point <code class="ic">add</code> at a GitHub repository, a Git URL, an archive or a local directory.
              Skillporter resolves it, selects the skills you name and installs them for the harnesses you choose.
            </p>
            <ul class="ticks">
              <li>Copy by default, relative symlinks on request</li>
              <li>Include, exclude or isolate specific harnesses</li>
              <li>Project scope, user scope and named profiles</li>
              <li>Export, diff and restore whole environments as .skillpack archives</li>
              <li>Removal and cross-harness move that keep shared copies intact</li>
            </ul>
            <p class="feature__links">
              <a class="arrow-link" href="/docs/skill-management">Skill management</a>
              <a class="arrow-link" href="/docs/portability">Portability and profiles</a>
            </p>
          </div>
          <CodeFrame
            code={addExamples}
            lang="bash"
            title="selective harness control"
            copy="skillporter add anthropics/skills --skill pdf --harness compatible"
          />
        </article>

        <article class="feature feature--flip">
          <div class="feature__text">
            <span class="index">Pillar B</span>
            <h3>Synchronization and reproducibility</h3>
            <p class="feature__kicker">Keep every environment consistent and know when something changes.</p>
            <p>
              Every copy of a skill is hashed. When one diverges, <code class="ic">diagnose</code> and
              <code class="ic">lock --check</code> say which copy and which hash. <code class="ic">sync</code> will not
              overwrite a changed copy until you name the authoritative one, and it snapshots what it replaces.
            </p>
            <ul class="ticks">
              <li>skillporter.lock pins the commit and every file hash</li>
              <li>Drift detection names the copy and the changed file</li>
              <li>Transactional install: stage, journal, swap, commit</li>
              <li>rollback restores the most recent snapshot</li>
            </ul>
            <a class="arrow-link" href="/docs/synchronization">Synchronization and lockfiles</a>
          </div>
          <div class="stack">
            <Transcript recording="lock-check-drift" title="lockfile check, after one copy was edited" wrap />
            <Transcript recording="rollback-dry-run" title="the snapshot taken before the overwrite" wrap />
          </div>
        </article>

        <div class="repro" id="reproducibility">
          <CodeFrame code={lockExample} lang="json" title="skillporter.lock" note={lockNote} copy={false} />
          <div class="repro__side">
            <dl class="fields">
              {
                lockFields.map(([name, text]) => (
                  <div>
                    <dt>
                      <code>{name}</code>
                    </dt>
                    <dd>{text}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="repro__limits">
              <h3>Where the guarantee stops</h3>
              <ul>
                <li>A local source is pinned by content, not by origin.</li>
                <li>An unpinned remote source makes the whole lockfile non-reproducible, and the file says so.</li>
                <li>The lockfile pins a skill's files. It does not pin what its scripts download at runtime.</li>
              </ul>
              <a class="arrow-link" href="/docs/lockfiles">Lockfiles</a>
            </div>
          </div>
        </div>

        <article class="feature feature--wide">
          <div class="feature__text">
            <h3>Transactional installation</h3>
            <p>
              Installing for several harnesses is one transaction. If a destination fails, the ones already written are
              restored. If the process is killed, a later run reads the journal and rolls the unfinished install back.
            </p>
            <a class="arrow-link" href="/docs/skill-management#how-installs-stay-consistent">How installs stay consistent</a>
          </div>
          <ol class="txn" aria-label="Install transaction">
            {
              transaction.map((item) => (
                <li>
                  <span class="txn__step">{item.step}</span>
                  <code>{item.path}</code>
                  <p>{item.body}</p>
                </li>
              ))
            }
            <li class="txn__fail">
              <span class="txn__step">On failure</span>
              <code>journal.json</code>
              <p>A later run reads the journal, removes what was created and puts back what was replaced.</p>
            </li>
          </ol>
        </article>

        <article class="feature">
          <div class="feature__text">
            <span class="index">Pillar C</span>
            <h3>Security and integrity</h3>
            <p class="feature__kicker">
              Understand what your agents are being instructed to do before installing untrusted skills.
            </p>
            <p>
              Skills contain prompt instructions and executable scripts. Before writing a file, Skillporter validates
              package structure, runs deterministic static analysis, compares declared vs. inferred capabilities, and
              evaluates your committed <code class="ic">skillporter.policy.yaml</code>.
            </p>
            <ul class="ticks">
              <li>Static AST, shell, archive and prompt-override analysis</li>
              <li>Project policies for approved sources, risk ceilings and banned capabilities</li>
              <li>Human-readable <code class="ic">update --check</code> diffs before accepting new versions</li>
              <li>Explicit boundary: static checks audit files and never guarantee runtime safety</li>
            </ul>
            <p class="feature__links">
              <a class="arrow-link" href="#security">Inspect the security model</a>
              <a class="arrow-link" href="/docs/policy">Policy and update review</a>
            </p>
          </div>
          <CodeFrame code={policyExample} lang="yaml" title="skillporter.policy.yaml + update review" />
        </article>
      </div>
    </section>

    <!-- =========================== HARNESSES ========================== -->
    <section class="section section--alt" id="harnesses" aria-labelledby="harnesses-title">
      <div class="wrap">
        <SectionHead
          index="04"
          label="Harness compatibility"
          id="harnesses-title"
          title="One skill management workflow. Multiple AI agent environments."
        >
          Support type says how a harness consumes a skill. Verification says what evidence backs the adapter. They are
          separate columns because they are separate claims: nothing is marked runtime verified just because a
          directory was created.
        </SectionHead>
        <HarnessMatrix />
      </div>
    </section>

    <!-- ============================= SECURITY ========================== -->
    <section class="section" id="security" aria-labelledby="security-title">
      <div class="wrap">
        <SectionHead
          index="05"
          label="Security and integrity"
          id="security-title"
          title="Understand what your agents are being instructed to do before installing untrusted skills."
        >
          Skillporter assesses a skill before it writes a file, and it is specific about what that assessment covers.
          It is static analysis, not a guarantee.
        </SectionHead>

        <div class="sec-grid">
          <Transcript
            recording="scan-unsafe-fixture"
            title="skillporter scan, on an unsafe test skill"
            note="The skill is a test fixture written for this page, not a published package."
            tall
            wrap
          />

          <div class="layers">
            <h3>Four separate questions</h3>
            <dl>
              {
                securityLayers.map((layer) => (
                  <div class:list={{ 'is-open': !layer.covered }}>
                    <dt>
                      {layer.name}
                      <span>{layer.by}</span>
                    </dt>
                    <dd>{layer.tells}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <div class="sec-lower">
          <div class="checks">
            <h3>What is checked</h3>
            <ul>
              {
                securityChecks.map(([name, detail]) => (
                  <li>
                    <b>{name}</b>
                    <span>{detail}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <aside class="limits" aria-labelledby="limits-title">
            <h3 id="limits-title">A clean scan does not prove a skill is safe at runtime.</h3>
            <ul>
              {limitations.map((item) => <li>{item}</li>)}
            </ul>
            <a class="btn btn--secondary" href="/docs/security">Explore Security Documentation</a>
          </aside>
        </div>
      </div>
    </section>

    <!-- =========================== WHY SKILLPORTER ====================== -->
    <section class="section section--alt" id="comparison" aria-labelledby="comparison-title">
      <div class="wrap">
        <SectionHead index="06" label="Why Skillporter" id="comparison-title" title="Compared to managing skills by hand.">
          Git and symlinks can do parts of this job, and nothing is hidden here. The difference is that the pieces that
          actually break are integrated into one workflow, with one record and one exit code.
        </SectionHead>

        <div class="compare" role="region" aria-label="Comparison of manual management, copy scripts and Skillporter">
          <table class="compare__table">
            <caption class="sr-only">
              Capability comparison: manual management, ad hoc copy scripts, and Skillporter.
            </caption>
            <thead>
              <tr>
                <th scope="col">Capability</th>
                <th scope="col">Manual management</th>
                <th scope="col">Copy scripts</th>
                <th scope="col" class="compare__col-sp">
                  <span class="chip chip--plain compare__sp">SkillPorter</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {
                comparison.map((row) => (
                  <tr>
                    <th scope="row">{row.dim}</th>
                    <td>{row.manual}</td>
                    <td>{row.scripts}</td>
                    <td class="compare__cell-sp">{row.sp}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="compare__note">
          If a skill is for a single agent in a single machine, copying the folder is fine. Skillporter earns its place
          where the same skills serve several agents, several projects, several people, or a CI pipeline that must fail
          on a risky update.
        </p>
      </div>
    </section>

    <!-- ============================ DEMO ============================== -->
    <section class="demo-band" aria-labelledby="demo-title">
      <div class="wrap">
        <div class="demo-band__head">
          <h2 id="demo-title">The CLI on a real workspace</h2>
          <p>Each panel is output recorded from the released CLI. Nothing runs in your browser.</p>
        </div>
        <TerminalDemo />
      </div>
    </section>

    <!-- ============================ WORKFLOW =========================== -->
    <section class="section" id="workflow" aria-labelledby="workflow-title">
      <div class="wrap">
        <SectionHead index="07" label="Developer workflow" id="workflow-title" title="The commands you will actually run.">
          Ten commands cover the lifecycle. Every one supports <code class="ic">--help</code>, and most support
          <code class="ic">--json</code>.
        </SectionHead>

        <ul class="cmds">
          {
            workflow.map((item) => (
              <li>
                <div class="cmds__cmd">
                  <code>
                    <span class="t-prompt" aria-hidden="true">
                      ${' '}
                    </span>
                    {item.command}
                  </code>
                  <CopyButton text={item.command} label={`Copy command: ${item.command}`} />
                </div>
                <p>{item.does}</p>
                <a href={item.docs} aria-label={`Documentation for ${item.command}`}>
                  Docs <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="more">
          <article class="more__cell">
            <h3>One set of instructions for every agent</h3>
            <p>
              <code class="ic">consolidate</code> finds CLAUDE.md, AGENTS.md, Cursor rules and the like, reports overlap
              and contradictions, and keeps one canonical source. Read-only by default, with a backup and
              <code class="ic">--rollback</code>.
            </p>
            <a class="arrow-link" href="/docs/instructions">Instruction files and context</a>
          </article>
          <article class="more__cell">
            <h3>Capabilities, policy and readable updates</h3>
            <p>
              A skill can declare what it needs, and a project policy decides which sources, capabilities and risk
              levels are allowed. <code class="ic">update --check</code> shows new files, new capabilities and new
              findings before you accept a version.
            </p>
            <a class="arrow-link" href="/docs/policy">Policy and update review</a>
          </article>
          <article class="more__cell">
            <h3>Author, test and measure</h3>
            <p>
              <code class="ic">new</code>, <code class="ic">lint</code>, <code class="ic">preview</code> and
              <code class="ic">test</code> cover the authoring loop. Offline tests are lexical and token figures are
              estimates; neither predicts what a model will do.
            </p>
            <a class="arrow-link" href="/docs/authoring">Authoring and testing</a>
          </article>
          <article class="more__cell">
            <h3>CI, GitHub Actions and MCP</h3>
            <p>
              Checks return fixed exit codes: <code class="ic">0</code> clean, <code class="ic">1</code> finding,
              <code class="ic">2</code> could not run. A GitHub Action and a read-only MCP server expose the same checks
              to your pipeline and your agents.
            </p>
            <p class="feature__links">
              <a class="arrow-link" href="/docs/ci">CI and GitHub Actions</a>
              <a class="arrow-link" href="/docs/mcp">MCP integration</a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================ ONBOARDING ========================= -->
    <section class="section section--alt" id="get-started" aria-labelledby="start-title">
      <div class="wrap">
        <SectionHead index="08" label="Get started" id="start-title" title="From install to first synchronized skill in three commands.">
          The recommended channel is <code class="ic">uv tool install skillporter</code>. Every channel below runs the
          same Python core with zero runtime dependencies.
        </SectionHead>

        <div class="onboard">
          <div class="onboard__panel">
            <p class="overline">Recommended install</p>
            <InstallPanel />
          </div>
          <ol class="onboard__first" aria-label="First workflow">
            <li>
              <span class="index">1</span>
              <div class="onboard__cmd">
                <code>
                  <span class="t-prompt" aria-hidden="true">$ </span>uvx skillporter demo
                </code>
                <CopyButton text="uvx skillporter demo" label="Copy demo command" />
              </div>
              <p>Try the whole workflow in a temporary directory. It writes nothing to your project.</p>
            </li>
            <li>
              <span class="index">2</span>
              <div class="onboard__cmd">
                <code>
                  <span class="t-prompt" aria-hidden="true">$ </span>skillporter add anthropics/skills --skill pdf
                </code>
                <CopyButton
                  text="skillporter add anthropics/skills --skill pdf"
                  label="Copy first add command"
                />
              </div>
              <p>Install a real skill across your detected or configured coding agents.</p>
            </li>
            <li>
              <span class="index">3</span>
              <div class="onboard__cmd">
                <code>
                  <span class="t-prompt" aria-hidden="true">$ </span>skillporter status
                </code>
                <CopyButton text="skillporter status" label="Copy status command" />
              </div>
              <p>See the manifest, the lockfile, and where every copy lives.</p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ============================ OPEN SOURCE ======================== -->
    <section class="section" id="open-source" aria-labelledby="oss-title">
      <div class="wrap">
        <SectionHead index="09" label="Open source" id="oss-title" title="Read the code. Run it yourself.">
          Skillporter is developed in the open under the {release.license} License. The adapter registry, the scanner
          rules and the installer are all in the repository.
        </SectionHead>

        <ul class="links">
          {
            projectLinks.map((link) => (
              <li>
                <a href={link.href} rel="noopener">
                  <span class="links__label">{link.label}</span>
                  <span class="links__detail">{link.detail}</span>
                  <span class="links__arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="closing">
          <div>
            <h2>Start with the demo.</h2>
            <p>It runs in a temporary directory and leaves nothing behind.</p>
          </div>
          <div class="closing__cmd">
            <code>
              <span class="t-prompt" aria-hidden="true">$ </span>uvx skillporter demo
            </code>
            <CopyButton text="uvx skillporter demo" label="Copy demo command" />
          </div>
          <div class="closing__actions">
            <a class="btn btn--primary" href="/docs/getting-started">Get Started</a>
            <a class="btn btn--secondary" href={LINKS.repo} rel="noopener">Explore GitHub</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

