  }
  .hero-ticker__node {
    flex: none;
    width: 7px;
    height: 7px;
    background: var(--amber);
    transform: rotate(45deg);
    animation: ticker-pulse 2.4s ease-in-out infinite;
  }
  .hero-ticker__src {
    flex: none;
    color: var(--ivory);
    font-weight: 500;
  }
  .hero-ticker__sep {
    flex: none;
    color: var(--amber-ink);
  }
  .hero-ticker__window {
    display: inline-block;
    height: 1.4em;
    overflow: hidden;
    vertical-align: bottom;
    min-width: 0;
  }
  .hero-ticker__track {
    display: flex;
    flex-direction: column;
    color: var(--blue-ink);
    animation: ticker-roll 14.4s cubic-bezier(0.22, 1, 0.36, 1) 1.2s infinite;
  }
  .hero-ticker__track > span {
    display: block;
    height: 1.4em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @keyframes ticker-pulse {
    0%,
    100% {
      transform: rotate(45deg) scale(0.92);
      opacity: 0.75;
    }
    50% {
      transform: rotate(45deg) scale(1.15);
      opacity: 1;
    }
  }
  @keyframes ticker-roll {
    0%,
    12% {
      transform: translateY(0);
    }
    16.66%,
    28.66% {
      transform: translateY(-1.4em);
    }
    33.33%,
    45.33% {
      transform: translateY(-2.8em);
    }
    50%,
    62% {
      transform: translateY(-4.2em);
    }
    66.66%,
    78.66% {
      transform: translateY(-5.6em);
    }
    83.33%,
    95.33% {
      transform: translateY(-7em);
    }
    100% {
      transform: translateY(-8.4em);
    }
  }

  .hero h1 {
    margin-top: 1.25rem;
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .hero-title__mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.1em;
  }
  .hero-title__line {
    display: inline-block;
    position: relative;
    will-change: transform;
  }
  .hero-title__line--1 {
    animation: title-curtain 740ms cubic-bezier(0.16, 1, 0.3, 1) 50ms both;
  }
  .hero-title__line--2 {
    animation: title-curtain 780ms cubic-bezier(0.16, 1, 0.3, 1) 150ms both;
  }
  @keyframes title-curtain {
    from {
      opacity: 0;
      transform: translateY(108%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Subtle precision light-sweep across "Every agent." */
  .hero-title__sheen {
    background-image: linear-gradient(
      108deg,
      var(--ivory) 0%,
      var(--ivory) 38%,
      var(--electric) 47%,
      var(--amber) 53%,
      var(--ivory) 62%,
      var(--ivory) 100%
    );
    background-size: 260% 100%;
    background-position: 100% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: title-sheen 7.5s cubic-bezier(0.4, 0, 0.2, 1) 0.9s infinite;
  }
  .hero h1:hover .hero-title__sheen {
    animation-duration: 3.2s;
  }
