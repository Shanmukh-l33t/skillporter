  .cmds__cmd code::-webkit-scrollbar {
    display: none;
  }
  .cmds .t-prompt {
    color: var(--amber-ink);
    user-select: none;
  }
  .cmds p {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .cmds li > a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-2);
    white-space: nowrap;
  }
  .cmds li > a:hover {
