    left: 0;
    width: 28%;
    height: 3.5px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--amber), transparent);
    animation: hero-span-flow 3.6s cubic-bezier(0.22, 1, 0.36, 1) 1.1s infinite;
    pointer-events: none;
  }
  @keyframes span-draw {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
