  .layers dd {
    margin: 0.4rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .layers .is-open dt span {
    color: var(--amber-ink);
  }

  .sec-lower {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem var(--gutter);
    align-items: start;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .checks ul {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
