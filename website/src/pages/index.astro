    14% {
      background-position: 100% 50%;
    }
    46%,
    100% {
      background-position: 0% 50%;
    }
  }

  /* Architectural bridge span rule under "Every agent." */
  .hero-title__span {
    position: relative;
    display: block;
    height: 1.5px;
    margin-top: 0.14em;
