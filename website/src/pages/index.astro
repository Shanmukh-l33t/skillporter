    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border-soft);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .checks b {
    font-weight: 500;
    color: var(--ivory);
  }
  .limits {
    padding: 1.6rem 1.6rem 1.75rem;
    background: var(--card);
    border: 1px solid var(--amber);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card);
  }
  .limits h3 {
    font-size: 1.25rem;
    line-height: 1.25;
  }
  .limits ul {
    margin: 1.1rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .limits li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* ------------------------------------------------------- reproducibility */
  .repro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem var(--gutter);
    align-items: start;
  }
  .fields {
    margin: 0;
    border-top: 1px solid var(--border);
  }
  .fields div {
    padding: 0.8rem 0 0.9rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .fields dt code {
    font-size: 0.8125rem;
    color: var(--blue-ink);
  }
  .fields dd {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .repro__limits {
    margin-top: 2.25rem;
  }
  .repro__limits h3 {
    font-size: 1.125rem;
  }
  .repro__limits ul {
    margin: 0.9rem 0 0.75rem;
    padding: 0;
    list-style: none;
  }
  .repro__limits li {
    position: relative;
    padding: 0.4rem 0 0.4rem 1.4rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .repro__limits li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.95rem;
    width: 6px;
    height: 6px;
    border: 1px solid var(--amber);
    transform: rotate(45deg);
  }

  /* -------------------------------------------------------------- commands */
  .cmds {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .cmds li {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr) auto;
    gap: 0.5rem 2rem;
    align-items: center;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .cmds__cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.35rem 0.4rem 0.35rem 0.85rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-card-sm);
    transition: border-color var(--dur) var(--ease);
