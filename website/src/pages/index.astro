    animation: hero-rise 560ms cubic-bezier(0.16, 1, 0.3, 1) 180ms both;
  }
  .hero__facts {
    animation: hero-rise 520ms cubic-bezier(0.16, 1, 0.3, 1) 360ms both;
  }
  .demo-band {
    animation: hero-rise 580ms cubic-bezier(0.16, 1, 0.3, 1) 400ms both;
  }
  .hero__grid {
